{
  "name": "sachin-rana-portfolio",
  "version": "5.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/check-leaks.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:leaks": "node scripts/check-leaks.mjs",
    "start": "npx serve out",
    "cv": "\"/Applications/Brave Browser.app/Contents/MacOS/Brave Browser\" --headless=new --disable-gpu --no-pdf-header-footer --print-to-pdf=public/Sachin_Rana_CV.pdf scripts/cv/cv.html",
    "check:repo": "node scripts/check-leaks.mjs --repo"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "eslint-config-next": "^15.5.28",
    "lucide-react": "^1.16.0",
    "next": "^15.5.28",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3"
  }
